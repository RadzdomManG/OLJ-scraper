# Backend process
UI_HOST=0.0.0.0
UI_PORT=8080
FRONTEND_ORIGIN=https://your-project.vercel.app
BACKEND_API_TOKEN=generate-a-long-random-secret
MAX_STORED_EVENTS=5000
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_CHAT_ID_ALL_JOBS=your-chat-id

# Extra public job sources. No job-site API keys or sign-ins are required.
INCLUDE_FREELANCER=true
INCLUDE_REMOTIVE=true
INCLUDE_WELLFOUND=true
INCLUDE_PEOPLEPERHOUR=true
INCLUDE_CONTRA=true
